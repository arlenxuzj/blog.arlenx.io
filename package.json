{
  "name": "arlenx.io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run db:generate && npm run content && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "commit": "cz",
    "sitemap": "tsx scripts/sitemap.ts",
    "og-image": "tsx scripts/og-image.ts",
    "scripts": "npm run sitemap && npm run og-image",
    "link-preview": "tsx scripts/link-preview.ts",
    "lint-staged": "lint-staged -v",
    "prepare": "is-ci || husky install",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "audit": "npm audit --audit-level=low",
    "content": "tsx scripts/content.ts",
    "postinstall": "node scripts/patch-dependencies.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=low"
  },
